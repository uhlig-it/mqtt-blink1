{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rebaseWhen": "behind-base-branch",
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the armv7 musl cross toolchain image referenced in release.yml (raw `docker pull` inside the workflow's run: block is not parsed by the built-in docker managers).",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/release\\.yml$/"],
      "matchStrings": [
        "(?m)^\\s*IMAGE=ghcr\\.io/cross-rs/armv7-unknown-linux-musleabihf:(?<currentValue>[\\w.+-]+)(@(?<currentDigest>sha256:[a-f0-9]{64}))?$"
      ],
      "depNameTemplate": "ghcr.io/cross-rs/armv7-unknown-linux-musleabihf",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Auto-merge Cargo patch updates (Cargo.toml/Cargo.lock) after required CI checks pass.",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Require human review for potentially breaking dependency updates.",
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false,
      "assignees": ["suhlig"]
    }
  ]
}
